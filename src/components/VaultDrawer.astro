---
import type { VaultFolder } from '../utils/vault-tree';
import VaultTreeNode from './VaultTreeNode.astro';

interface Props {
  tree: VaultFolder;
}

const { tree } = Astro.props;
---

<!-- Telón de fondo (Backdrop) -->
<div class="vault-drawer-backdrop" id="vault-drawer-backdrop" aria-hidden="true"></div>

<!-- Panel lateral desplegable (Drawer) -->
<aside
  class="vault-drawer"
  id="vault-drawer"
  aria-label="Explorador de Códices"
  aria-hidden="true"
>
  <div class="vault-drawer__inner">
    <!-- Cabecera del menú -->
    <header class="vault-drawer__header">
      <div class="vault-drawer__title-wrap">
        <span class="vault-drawer__badge-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
            <path d="M6 6h10"></path>
            <path d="M6 10h10"></path>
          </svg>
        </span>
        <h2 class="vault-drawer__title">Códices de la Bóveda</h2>
      </div>

      <button
        type="button"
        class="vault-drawer__close"
        id="vault-drawer-close"
        aria-label="Cerrar menú"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <!-- Contenido del menú -->
    <div class="vault-drawer__content">
      <div class="vault-drawer__intro">
        <a href="/codices/" class="vault-drawer__all-link">
          <span>Ver índice completo de Códices</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Árbol de carpetas y subcarpetas de Obsidian -->
      {tree.subfolders.length > 0 ? (
        <div class="vault-drawer__section">
          <span class="vault-drawer__section-title">Estructura de Códices</span>
          <ul class="vault-tree-root">
            {tree.subfolders.map((folder) => (
              <VaultTreeNode folder={folder} depth={0} />
            ))}
          </ul>
        </div>
      ) : (
        <div class="vault-drawer__empty">
          <p>
            No hay carpetas adicionales en tu bóveda de Obsidian aún.
          </p>
          <p class="hint">
            Crea carpetas dentro de Obsidian (como <code>Planos</code>, <code>Facciones</code> o <code>Reglas</code>) y aparecerán automáticamente aquí clasificadas.
          </p>
        </div>
      )}

      <!-- Artículos sueltos de la raíz si los hay -->
      {tree.articles.length > 0 && (
        <div class="vault-drawer__section">
          <span class="vault-drawer__section-title">Crónicas Principales</span>
          <ul class="vault-tree-root">
            {tree.articles.map((art) => (
              <li class="tree-article-item">
                <a href={art.href} class="tree-article__link">
                  <span class="tree-article__bullet" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                  </span>
                  <span class="tree-article__title">{art.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <!-- Pie del menú -->
    <footer class="vault-drawer__footer">
      <p>Bóveda sincronizada con Obsidian</p>
    </footer>
  </div>
</aside>

<script>
  function setupVaultDrawer() {
    const drawer = document.getElementById('vault-drawer');
    const toggleBtn = document.getElementById('vault-menu-toggle');
    const closeBtn = document.getElementById('vault-drawer-close');
    const backdrop = document.getElementById('vault-drawer-backdrop');

    if (!drawer) return;

    function openDrawer() {
      drawer?.classList.add('is-open');
      backdrop?.classList.add('is-open');
      drawer?.setAttribute('aria-hidden', 'false');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer?.classList.remove('is-open');
      backdrop?.classList.remove('is-open');
      drawer?.setAttribute('aria-hidden', 'true');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    // Botón hamburguesa
    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = drawer.classList.contains('is-open');
      if (isOpen) closeDrawer();
      else openDrawer();
    });

    // Botón cerrar y backdrop
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    // Tecla Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeDrawer();
      }
    });

    // Acordeón de árbol (botón con flecha)
    // Al pulsar esta flecha, sin cambiar de pestaña, en ese mismo menú se ve el contenido
    document.querySelectorAll('[data-tree-toggle]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        const item = btn.closest('[data-tree-item]');
        if (!item) return;

        const isExpanded = item.classList.contains('is-expanded');
        item.classList.toggle('is-expanded');
        btn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
      });
    });
  }

  // Ejecutar en carga inicial y compatible con transiciones de página
  setupVaultDrawer();
  document.addEventListener('astro:page-load', setupVaultDrawer);
</script>

<style>
  /* Telón de fondo */
  .vault-drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .vault-drawer-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* Cajón lateral */
  .vault-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(92vw, 380px);
    z-index: 160;
    background: rgba(10, 12, 20, 0.94);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-left: 1px solid var(--border);
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.7);
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  .vault-drawer.is-open {
    transform: translateX(0);
  }

  .vault-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  /* Cabecera */
  .vault-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .vault-drawer__title-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .vault-drawer__badge-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-xs);
    background: rgba(39, 85, 237, 0.15);
    border: 1px solid rgba(39, 85, 237, 0.3);
    color: #7da0ff;
  }

  .vault-drawer__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .vault-drawer__close {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-xs);
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .vault-drawer__close:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* Cuerpo */
  .vault-drawer__content {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem 1.5rem;
    overscroll-behavior: contain;
  }

  .vault-drawer__intro {
    margin-bottom: 1.5rem;
  }

  .vault-drawer__all-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius-sm);
    background: rgba(39, 85, 237, 0.08);
    border: 1px solid rgba(39, 85, 237, 0.25);
    color: #7da0ff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .vault-drawer__all-link:hover {
    background: rgba(39, 85, 237, 0.18);
    border-color: rgba(39, 85, 237, 0.45);
    color: #fff;
  }

  .vault-drawer__section {
    margin-bottom: 1.5rem;
  }

  .vault-drawer__section-title {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    margin-bottom: 0.75rem;
  }

  .vault-tree-root {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vault-drawer__empty {
    padding: 1.5rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px dashed var(--border);
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .vault-drawer__empty p {
    margin: 0 0 0.5rem;
  }

  .vault-drawer__empty .hint {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .vault-drawer__empty code {
    font-family: var(--font-mono);
    color: var(--brand-primary);
  }

  /* Pie */
  .vault-drawer__footer {
    padding: 0.9rem 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--text-faint);
    text-align: center;
  }

  .vault-drawer__footer p {
    margin: 0;
  }

  /* Artículos sueltos en el root */
  .tree-article-item {
    list-style: none;
    margin: 0.1rem 0;
  }

  .tree-article__link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.85rem;
    border-radius: var(--radius-xs);
    transition: color 0.15s ease, background 0.15s ease;
  }

  .tree-article__link:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
  }

  .tree-article__bullet {
    display: grid;
    place-items: center;
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .tree-article__link:hover .tree-article__bullet {
    color: var(--brand-primary);
  }

  .tree-article__title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
