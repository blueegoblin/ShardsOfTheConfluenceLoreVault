---
import "../styles/global.css";
import AeroShards from "../components/AeroShards.jsx";

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Si es true, la cabecera flota de forma transparente sobre un hero a pantalla completa. */
  overlayHeader?: boolean;
  /** Si es true, muestra el fondo 3D AeroShards. Por defecto solo en la página principal. */
  showShards?: boolean;
  /** Disposición de los AeroShards ('full', 'left', 'right', 'center'). Por defecto 'right'. */
  shardsPlacement?: "full" | "left" | "right" | "center";
}

const SITE_NAME = "Confluencia";
const isHome =
  Astro.url.pathname === "/" ||
  Astro.url.pathname === "" ||
  Astro.url.pathname === "/index.html";
const {
  title,
  description = "Compendio y lore del sistema de rol Confluencia. Explora los Fragmentos: planos de la realidad interconectados a través de nexos dimensionales.",
  image,
  overlayHeader = false,
  showShards = isHome,
  shardsPlacement = "right",
} = Astro.props;

const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=Inter:wght@400..700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Marca el documento como "con JS" antes del primer pintado para que
         los elementos animados empiecen ocultos sin parpadeo. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    {
      showShards && (
        <div class="aero-shards-bg" aria-hidden="true">
          <AeroShards
            client:only="react"
            shardColor="#2755ed"
            accentColor="#2755ed"
            placement={shardsPlacement}
            material="chrome"
            markers="none"
            count={800}
            depthOfField={0.5}
            vignette={0.3}
            mouseInteraction
            pulseOnClick
            holdToGather
            lightMode={false}
            shardSize={1.4}
            spread={1}
            twist={1}
            billow={0.7}
            speed={1}
            scale={1}
            glow={1.5}
            grain={0.06}
            intro
            mouseStrength={0.75}
            parallax={0.5}
            paused={false}
          />
          <div class="aero-shards-blur-overlay" />
        </div>
      )
    }

    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header
      class:list={["site-header", { "site-header--overlay": overlayHeader }]}
    >
      <div class="container site-header__inner">
        <a href="/" class="brand" aria-label="Confluencia, inicio">
          <span class="brand__mark" aria-hidden="true">
            <svg
              viewBox="0 0 442 609"
              width="24"
              height="33"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M365 493H78L103.768 349H106.555C115.238 366.887 121.006 385.319 121.024 385.379C121.006 385.321 115.683 368.272 112.409 349H160.441C168.767 377.703 173.159 406.689 173.159 406.689C173.159 406.689 168.924 378.706 168.2 349H215.449C220.996 395.695 221 447.798 221 447.798C221 447.798 221.003 395.695 226.551 349H273.801C273.077 378.706 268.841 406.689 268.841 406.689C268.841 406.689 273.232 377.703 281.559 349H329.591C326.317 368.274 320.992 385.325 320.976 385.379C320.993 385.323 326.762 366.889 335.446 349H339.232L365 493Z"
                fill="#1B399E"></path>
              <path
                d="M217.452 368.58C220.997 409.141 221 447.798 221 447.798C221 447.798 221.003 409.141 224.548 368.581L299.136 443.866L442 487L299.136 530.134L221 609L142.864 530.134L0 487L142.864 443.866L217.452 368.58Z"
                fill="#1B399E"></path>
              <path
                d="M309.745 84.4561L420 126.75L397.99 253.5L420 380.25L309.745 422.544L221.5 447L221.003 446.862C221.062 433.296 222.43 276.736 254 276.736C221.001 276.736 221 95.7979 221 95.7979C221 95.7979 221.001 276.736 188 276.736C219.569 276.736 220.937 433.281 220.996 446.86L133.255 422.544L23 380.25L45.0098 253.5L23 126.75L133.255 84.4561L221.5 0L309.745 84.4561ZM135.729 159.502C135.729 159.502 154.97 286.563 122.408 293.249C154.97 286.564 173.159 406.689 173.159 406.689C173.159 406.689 154.97 286.563 187.53 279.878C154.97 286.563 135.729 159.502 135.729 159.502ZM306.271 159.502C306.271 159.502 287.031 286.564 254.47 279.879C287.031 286.564 268.841 406.689 268.841 406.689C268.841 406.689 287.032 286.564 319.592 293.249C287.032 286.563 306.271 159.502 306.271 159.502ZM70.21 222.812C70.2452 222.925 96.3141 306.384 72.1201 316.638C96.3115 306.385 120.986 385.255 121.024 385.379C120.986 385.255 96.3497 306.369 120.54 296.116C96.3469 306.37 70.2453 222.925 70.21 222.812ZM371.79 222.812C371.752 222.934 345.653 306.37 321.46 296.116C345.653 306.369 321.012 385.263 320.976 385.379C321.012 385.263 345.688 306.385 369.88 316.638C345.688 306.385 371.752 222.934 371.79 222.812Z"
                fill="#2755ED"></path>
              <path
                d="M361.917 249.505C352.112 272.963 336.422 302.457 321.46 296.116C345.653 306.369 321.012 385.263 320.976 385.379C321.003 385.292 334.701 341.51 351.686 323.409L332.5 462L222.5 486.5L110.5 462L91.4941 324.713C107.928 343.521 120.996 385.289 121.024 385.379C120.986 385.255 96.3497 306.369 120.54 296.116C106.311 302.147 91.4234 275.766 81.5654 252.99L68 155H219.149C216.167 207.775 208.373 276.736 188 276.736C221.001 276.736 221 447.798 221 447.798C221 447.798 221.001 276.736 254 276.736C233.628 276.736 225.834 207.775 222.851 155H375L361.917 249.505ZM135.729 159.502C135.729 159.502 154.97 286.563 122.408 293.249C154.97 286.564 173.159 406.689 173.159 406.689C173.159 406.689 154.97 286.563 187.53 279.878C154.97 286.563 135.729 159.502 135.729 159.502ZM306.271 159.502C306.271 159.502 287.031 286.564 254.47 279.879C287.031 286.564 268.841 406.689 268.841 406.689C268.841 406.689 287.032 286.564 319.592 293.249C287.032 286.563 306.271 159.502 306.271 159.502Z"
                fill="#2755ED"></path>
            </svg>
          </span>
          <span class="brand__name">Confluencia</span>
        </a>
        <nav aria-label="Principal">
          <ul class="nav">
            <li><a href="/#articulos">Artículos</a></li>
            <li><a href="/#red">Red</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <div id="contenido">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>
          © {new Date().getFullYear()} Confluencia · Lore y Crónicas de los Fragmentos
        </p>
        <p class="site-footer__hint">
          Comienza el viaje en los <code>Fragmentos</code>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .aero-shards-bg {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .aero-shards-bg :global(astro-island),
  .aero-shards-bg :global(.aero-shards),
  .aero-shards-bg :global(.aero-shards-canvas) {
    display: block !important;
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  .aero-shards-blur-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    background: rgba(0, 0, 0, 0.05);
  }

  #contenido {
    position: relative;
    z-index: 10;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 200;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--brand-primary);
    color: #ffffff;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 0.3s var(--ease-out);
  }

  .skip-link:focus {
    transform: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 0.9rem;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border-bottom: 1px solid var(--border);
  }

  .site-header--overlay {
    position: fixed;
    inset: 0 0 auto;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.75), transparent);
    border-bottom-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--text);
  }

  .brand__mark svg {
    display: block;
    transition: filter 0.3s ease;
    filter: drop-shadow(0 0 0 transparent);
  }

  .brand:hover .brand__mark svg,
  .brand:focus-visible .brand__mark svg,
  .brand:active .brand__mark svg {
    filter: drop-shadow(0 0 10px #2755ed) drop-shadow(0 0 22px rgba(39, 85, 237, 0.8)) brightness(1.3);
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    transition: color 0.3s ease, text-shadow 0.3s ease;
  }

  .brand:hover .brand__name,
  .brand:focus-visible .brand__name {
    color: #fff;
    text-shadow: 0 0 12px rgba(39, 85, 237, 0.45);
  }

  .nav {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .nav a {
    display: block;
    padding: 0.35rem 0.95rem;
    border-radius: var(--radius-xs);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .nav a:hover {
    background: var(--surface-strong);
    color: var(--text);
  }

  .site-footer {
    position: relative;
    z-index: 10;
    margin-top: 6rem;
    padding-block: 2.5rem;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--border);
    color: var(--text-faint);
    font-size: 0.875rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--brand-primary);
  }
</style>
