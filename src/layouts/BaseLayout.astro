---
import '../styles/global.css';
import AeroShards from '../components/AeroShards.jsx';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Si es true, la cabecera flota de forma transparente sobre un hero a pantalla completa. */
  overlayHeader?: boolean;
  /** Si es true, muestra el fondo 3D AeroShards. Por defecto solo en la página principal. */
  showShards?: boolean;
}

const SITE_NAME = 'Confluencia';
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '' || Astro.url.pathname === '/index.html';
const {
  title,
  description = 'Un blog estático donde cada idea es un nodo de una red de conocimiento.',
  image,
  overlayHeader = false,
  showShards = isHome,
} = Astro.props;

const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=Inter:wght@400..700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Marca el documento como "con JS" antes del primer pintado para que
         los elementos animados empiecen ocultos sin parpadeo. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    {
      showShards && (
        <div class="aero-shards-bg" aria-hidden="true">
          <AeroShards
            client:only="react"
            shardColor="#2755ed"
            accentColor="#2755ed"
            placement="full"
            material="chrome"
            markers="none"
            count={800}
            depthOfField={0.5}
            vignette={0.3}
            mouseInteraction
            pulseOnClick
            holdToGather
            lightMode={false}
            shardSize={1.4}
            spread={1}
            twist={1}
            billow={0.7}
            speed={1}
            scale={1}
            glow={1.5}
            grain={0.06}
            intro
            mouseStrength={0.75}
            parallax={0.5}
            paused={false}
          />
          <div class="aero-shards-blur-overlay" />
        </div>
      )
    }

    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class:list={['site-header', { 'site-header--overlay': overlayHeader }]}>
      <div class="container site-header__inner">
        <a href="/" class="brand" aria-label="Confluencia, inicio">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="28" height="28">
              <defs>
                <linearGradient id="brand-g" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#2755ED" />
                  <stop offset="1" stop-color="#1B399E" />
                </linearGradient>
              </defs>
              <path d="M8 9 L24 9 L16 24 Z" fill="none" stroke="url(#brand-g)" stroke-width="1.6" />
              <circle cx="8" cy="9" r="3.2" fill="url(#brand-g)" />
              <circle cx="24" cy="9" r="3.2" fill="url(#brand-g)" />
              <circle cx="16" cy="24" r="3.2" fill="url(#brand-g)" />
            </svg>
          </span>
          <span class="brand__name">Confluencia</span>
        </a>
        <nav aria-label="Principal">
          <ul class="nav">
            <li><a href="/#articulos">Artículos</a></li>
            <li><a href="/#red">Red</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <div id="contenido">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>© {new Date().getFullYear()} Confluencia · Construido con Astro y Anime.js</p>
        <p class="site-footer__hint">Escribe <code>[[nombre-del-archivo]]</code> para tejer la red.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .aero-shards-bg {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .aero-shards-bg :global(astro-island),
  .aero-shards-bg :global(.aero-shards),
  .aero-shards-bg :global(.aero-shards-canvas) {
    display: block !important;
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  .aero-shards-blur-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    background: rgba(0, 0, 0, 0.05);
  }

  #contenido {
    position: relative;
    z-index: 10;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 200;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--brand-primary);
    color: #ffffff;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 0.3s var(--ease-out);
  }

  .skip-link:focus {
    transform: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 0.9rem;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border-bottom: 1px solid var(--border);
  }

  .site-header--overlay {
    position: fixed;
    inset: 0 0 auto;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.75), transparent);
    border-bottom-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }

  .brand__mark svg {
    transition: transform 0.8s var(--ease-out);
  }

  .brand:hover .brand__mark svg {
    transform: rotate(120deg);
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .nav a {
    display: block;
    padding: 0.35rem 0.95rem;
    border-radius: var(--radius-xs);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .nav a:hover {
    background: var(--surface-strong);
    color: var(--text);
  }

  .site-footer {
    position: relative;
    z-index: 10;
    margin-top: 6rem;
    padding-block: 2.5rem;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--border);
    color: var(--text-faint);
    font-size: 0.875rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--brand-primary);
  }
</style>
